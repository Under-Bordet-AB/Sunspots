{
  "system": {
    "version": "1.0",
    "name": "Sunspots Daemon",
    "log_path": "/var/log/sunspots.log"
  },
  "modules": [
    {
      "name": "Service_Heartbeat_Mode",
      "bin_path": "/usr/local/bin/my_service",
      "Timer-type": 0,
      "heartbeat_interval": 5
    },
    {
      "name": "Task_Absolute_Mode",
      "bin_path": "/usr/local/bin/daily_cleanup",
      "Timer-type": 1,
      "Abs-time": "02:30"
    },
    {
      "name": "Task_Relative_Mode",
      "bin_path": "/usr/local/bin/check_temp",
      "Timer-type": 1,
      "Rel-time": 30
    }
  ]
}
