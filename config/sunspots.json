{
  "system": {
    "version": "1.0",
    "name": "Sunspots Daemon",
    "log_path": "./logs/daemon.log",
    "socket_path": "./logs/sunspots.sock",
    "location": {
      "id": "stockholm-home",
      "name": "Stockholm",
      "latitude": 59.3293,
      "longitude": 18.0686,
      "elprisomrade": "SE3"
    },
    "sdk": {
      "db_dir": "db",
      "log_level": "info",
      "log_mirror_enabled": true,
      "log_mirror_path": "logs/sdk.log",
      "log_mirror_max_bytes": "5242880"
    }
  },
  "modules": [
    {
      "name": "Logger",
      "bin_path": "./build/debug/src/core/sunspots_logger",
      "Timer-type": 0,
      "heartbeat_interval": 3,
      "log_path": "./logs/daemon.log"
    },
    {
      "name": "Elprisjustnu",
      "bin_path": "./build/debug/src/fetch/apis/sunspots_fetch_elprisjustnu",
      "Timer-type": 1,
      "Rel-time": 50,
      "start_at_boot": 1
    },
    {
      "name": "ComputeManager",
      "bin_path": "./build/debug/src/compute/sunspots_compute_manager",
      "Timer-type": 1,
      "Rel-time": 60,
      "compute_method": 0,
      "exp_backoff_poll_rate": 3,
      "exp_backoff_timeout": 5400,
      "start_at_boot": 1
    },
    {
      "name": "Openmeteo",
      "bin_path": "./build/debug/src/fetch/apis/sunspots_fetch_openmeteo",
      "Timer-type": 1,
      "Rel-time": 30,
      "start_at_boot": 1
    },
    {
      "name": "Openmeteo_forecast",
      "bin_path": "./build/debug/src/fetch/apis/sunspots_fetch_openmeteo_forecast",
      "Timer-type": 1,
      "Rel-time": 100,
      "start_at_boot": 1
    },
    {
      "name": "BackfillOpenMeteo",
      "bin_path": "./build/debug/src/backfill/backfill_openmeteo",
      "Timer-type": 1,
      "Rel-time": 3600,
      "start_at_boot": 1,
      "backfill": {
        "enabled": true,
        "perfmode": "fast",
        "start_date_utc": "2026-03-01",
        "chunk_days": 1,
        "retry_max_attempts": 5,
        "retry_base_backoff_ms": 1000,
        "freshness_lag_minutes": 120,
        "request_interval_ms": 5000,
        "max_requests_per_minute": 10,
        "max_requests_per_hour": 120,
        "max_requests_per_day": 500,
        "progress_log_interval_sec": 10,
        "usage_daily_path": "logs/backfill_usage_daily.log"
      }
    },
    {
      "name": "BackfillElprisjustnu",
      "bin_path": "./build/debug/src/backfill/backfill_elprisetjustnu",
      "Timer-type": 1,
      "Rel-time": 3600,
      "start_at_boot": 1,
      "backfill": {
        "enabled": true,
        "perfmode": "fast",
        "start_date_utc": "2026-03-01",
        "retry_max_attempts": 5,
        "retry_base_backoff_ms": 1000,
        "request_interval_ms": 5000,
        "max_requests_per_minute": 10,
        "max_requests_per_hour": 120,
        "max_requests_per_day": 500,
        "usage_daily_path": "logs/backfill_price_usage_daily.log",
        "endpoint": "https://www.elprisetjustnu.se/api/v1/prices"
      }
    },
    {
      "name": "Frontend",
      "bin_path": "./build/debug/src/frontend/sunspots_frontend",
      "Timer-type": 0,
      "heartbeat_interval": 4,
      "server_threads": 8,
      "server_port_http": 10480,
      "server_port_https": null,
      "server_listen_queue": 16,
      "client_queue_size": 32,
      "allow_file_search": true,
      "file_search_dir": "./",
      "aliases": [
        {
          "target_url": "/README",
          "target_file": "./README.md"
        }
      ]
    }
  ]
}
