CC := gcc
SRC_LIBS := $(shell find ../../libs -type f -name '*.c')
SOURCES := fetch_elprisjustnu.c $(SRC_LIBS)
INCLUDES := -I.. -I../../ -I../../libs -I/usr/include/cjson/
CFLAGS := -Wall -Wextra -Wno-unused-parameter -pthread
LDFLAGS := -lcurl

TARGET := fetch_elprisjustnu

fetch_elprisjustnu: fetch_elprisjustnu.c
	$(CC) $(SOURCES) -o $(TARGET) $(CFLAGS) $(INCLUDES) $(LDFLAGS)

clean:
	rm -f fetch_elprisjustnu
