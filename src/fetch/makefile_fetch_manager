CC := gcc
SRC_LIBS := $(shell find src/libs -type f -name '*.c')
SOURCES := fetch_manager_forks.c $(SRC_LIBS)
INCLUDES := -I.. -I../../ -I../libs -I/usr/include/cjson/
CFLAGS := -Wall -Wextra -Wno-unused-parameter -pthread
LDFLAGS := -lcurl -lcjson
TARGET := fetch_manager

fetch_manager: fetch_manager_forks.c
	$(CC) $(SOURCES) -o $(TARGET) $(CFLAGS) $(INCLUDES) $(LDFLAGS)

clean:
	rm -f fetch_manager

run:
	./fetch_manager 1